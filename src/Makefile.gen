EXPAND DEPTH

USE STANDARD_ENV

SUBDIRS = tools example targets:DIR:$(TARGET)
OUTDIRS = $(LIBOUT) $(INCOUT)
LIBRARY = $(SEMLIB)

PUBINCS seminole.h

EXPAND SRCDEPS

USE STD_RULES MAKE_LIBRARY MAKE_INCS MAKE_PREP
