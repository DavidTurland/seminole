use strict;

sub common_tokens
{
  my @timeinfo = gmtime(time);

  while (<INPUT>)
  {
     s/__YEAR__/$timeinfo[5] + 1900/geo;

     print OUTPUT $_;
  }

  return 1; # Very important to indicate success.
}
