EXPAND DEPTH

USE STANDARD_ENV

OUTDIRS = $(BINOUT)
BINARY  = $(SEMBIN)
LIBS    = $(SEMLIB) $(SEMTGTLIB)
CONTENT = $(BINOUT):DIR:semweb.pkg 

EXTRA_INCLUDE $(SEMINCLUDE)

EXPAND SRCDEPS

USE STD_RULES MAKE_BIN MAKE_PREP MAKE_CONTENT
