 </section>

 <section><title>Public Data</title>
  <section><title><varname>mPair</varname></title>
   <para>
    <literal>HttpdPair</literal><varname> mPair</varname><token>;</token>
   </para>

   <para>
    The parameter name and value of this
    <classname>HttpdCgiParameter</classname>.    
   </para>

  </section>

  <section><title><varname>mpNext</varname></title>
   <para>
    <literal>HttpdCgiParameter
    *</literal><varname>mpNext</varname><token>;</token>
   </para>

   <para>
    A pointer to the next <classname>HttpdCgiParameter</classname>
    object on the list, or <symbol>NULL</symbol> if this object is the
    last member of the list.
   </para>

  </section>

 </section>

</chapter>

