### Various system- or environment-specific tweakable parameters.

# Output product filenames.
OBJSFX     = obj
SEMLIB     = $(LIBOUT)\seminole.lib
SEMTGTLIB  = $(LIBOUT)\semtgt.lib
SEMBIN     = $(BINOUT)\shttpd.exe
SEMINC     = $(INCOUT)\seminole.h

# Basic directory paths.
BUILT_DIR  = $(DEPTH)\built\$(PORT)-$(TARGET)
LIBOUT     = $(BUILT_DIR)\lib
BINOUT     = $(BUILT_DIR)\bin
INCOUT     = $(BUILT_DIR)\include
HTMLOUT    = $(DEPTH)\built\doc\html
TOOLOUT    = $(DEPTH)\built\tools

# Use the winsock library
SYSLIBS    = ws2_32.lib

# Default optimizations.
CFLAGS     = /Ox /I$(INCOUT) /DNDEBUG /DWIN32 /MD 

# Use the CL driver to do both compiling and linking.
CXX        = cl
AR         = lib 
LD         = cl
PERL       = perl

# Tool parameters.
#
# Normally, on Win32 we do not assume a cross-development environment.
# Otherwise, HOSTCXX != CXX and HOSTCFLAGS != CFLAGS.
PERLEXT    = .pl
TOOLEXT    = .exe
HOSTCXX    = $(CXX)
HOSTCFLAGS = $(CFLAGS)
MKTOOL     = $(DEPTH)/maketool.pl

# Build System Parameters
MAKERULES  = nmake.rl

SHELL      = CMD
MKDIR      = MKDIR
RM         = DEL
MV         = MOVE
CP         = XCOPY

CLEAN_DIR_CMD   = $(RM) /s/q 
PREP_DIR_CMD    = $(MKDIR) 
LD_BINARY_CMD   = $(LD) /Fe$@ $(OBJS) $(LIBS) $(SYSLIBS)
MK_LIB_CMD      = $(AR) /OUT:$@ $(OBJS)
RECURSE_CMD     = @FOR %%s IN ($(SUBDIRS)) DO CMD /C "CD %%s && $(MAKE) $(MFLAGS) $@"
