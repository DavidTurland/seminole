### Various system- or environment-specific tweakable parameters.

## Settings for OpenBSD systems

# Default optimizations.
CFLAGS   = -O2 -fomit-frame-pointer -Wall -I$(INCOUT) -DNDEBUG \
           -xc++ -fno-rtti -DHTTPD_OS_NAME=\"OpenBSD\" \
           -DHTTPD_USE_MMAP -DHTTPD_USE_POLL
LDFLAGS  = -s

# Debug builds:
#CFLAGS  = -g -Wall -I$(INCOUT) -xc++ -DHTTPD_OS_NAME=\"OpenBSD\" \
#          -DHTTPD_USE_MMAP -DHTTPD_USE_POLL
#
#LDFLAGS = -g


# Default to the GNU C++ compiler.
CXX      = /usr/bin/g++ -pthread
AR       = /usr/bin/ar
RANLIB   = /usr/bin/ranlib
PERL     = /usr/bin/perl

# Everything else is POSIXly delicious.
include $(DEPTH)/ports/POSIX

